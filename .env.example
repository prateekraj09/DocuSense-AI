# ==============================================================================
# DocuSense AI - Environment Configuration Template
# ==============================================================================

# Application
PROJECT_NAME="DocuSense AI"
ENVIRONMENT=development
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docusense_ai

# Async SQLAlchemy DB URL:
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docusense_ai

# Redis Configuration (Cache, Rate Limiting, Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
GENERATION_MODEL=gemini-1.5-flash
